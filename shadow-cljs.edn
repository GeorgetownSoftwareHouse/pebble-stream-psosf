;; The npm packages, both ES modules with fflate kept as an import:
;;   npm        -> npm/psosf/dist/             @pebblestream/psosf
;;   directives -> npm/psosf-directives/dist/  @pebblestream/psosf-directives
;; and test-directives, which runs the directive check's tests under Node.
{:source-paths ["src" "directives/src" "directives/test"]
 :dependencies [[metosin/malli "0.16.4"]]
 :builds
 {:npm {:target     :esm
        :output-dir "npm/psosf/dist"
        :js-options {:js-provider :import}
        :modules    {:psosf {:exports {classify    psosf.js/classify
                                       read        psosf.js/read
                                       write       psosf.js/write
                                       unzip       psosf.js/unzip
                                       zip         psosf.js/zip
                                       classifyZip psosf.js/classify-zip}}}}

  :directives {:target     :esm
               :output-dir "npm/psosf-directives/dist"
               :js-options {:js-provider :import}
               :modules    {:psosf-directives {:exports {check     pebblestream.directives.js/check
                                                         checkZip  pebblestream.directives.js/check-zip
                                                         parseLine pebblestream.directives.js/parse-line}}}}

  :test-directives {:target    :node-test
                    :output-to "target/test-directives.js"
                    :ns-regexp "pebblestream\\.directives\\.js-test$"}}}
