{
  "name": "pebble-stream-psosf-workspace",
  "private": true,
  "version": "0.1.0",
  "description": "Development workspace for the PSOSF npm packages. Not published.",
  "license": "Apache-2.0",
  "workspaces": [
    "npm/psosf",
    "npm/psosf-directives"
  ],
  "scripts": {
    "build": "shadow-cljs release npm directives",
    "test": "nbb --classpath src:test test/psosf/js_runner.cljs",
    "test:directives": "shadow-cljs compile test-directives && node target/test-directives.js"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "nbb": "^1.3.0",
    "shadow-cljs": "^3.5.0",
    "fflate": "^0.8.2"
  }
}
